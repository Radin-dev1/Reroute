{
  "name": "reroute-claude",
  "version": "0.1.0",
  "description": "Local proxy for Claude Code (terminal + desktop) that switches to the best open-source model when your Claude credits or usage limit run out.",
  "type": "module",
  "bin": {
    "reroute": "bin/reroute.js"
  },
  "main": "src/server.js",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/reroute.js start",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "proxy",
    "fallback",
    "open-source",
    "ollama",
    "openrouter"
  ],
  "author": "Radin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Radin-dev1/Reroute.git"
  }
}
